Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_InterProcess}"
{
	%Group "InterProcess"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/InterProcess/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_InterProcess true
	{
		&
		{
			MalterlibLibrary_InterProcess ""
			MalterlibLibrary_All true
		}
	}
	MalterlibSubLibraries "InterProcess;@(MalterlibSubLibraries)"
	{
		!!MalterlibLibrary_InterProcess true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_InterProcess true
	MalterlibIncludeRoots "@('Include'->MakeAbsolute());@(MalterlibIncludeRoots)"
	{
		!!MalterlibLibrary_InterProcess true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests "Malterlib_InterProcess;@(MalterlibTests)"
	MalterlibTestFiles_Malterlib_InterProcess "@('Test/*'->MakeAbsolute())"
}

