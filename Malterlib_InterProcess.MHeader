Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_InterProcess}"
{
	%Group "InterProcess"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/InterProcess/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_InterProcess: bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "InterProcess"
	{
		!!MalterlibLibrary_InterProcess true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_InterProcess: bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_InterProcess true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_InterProcess"
	MalterlibTestFiles_Malterlib_InterProcess: [type(CEntity)] = ["Test/*"->MakeAbsolute()]
}

